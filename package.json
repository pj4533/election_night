{
  "name": "election-night",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Election Night 2026 — 24-hour-news-style 3D live results broadcast",
  "scripts": {
    "start": "node server/index.mjs",
    "sim": "SIM=1 PORT=4174 node server/index.mjs",
    "check": "node --check server/index.mjs && for f in server/*.mjs server/sources/*.mjs public/js/*.js public/js/scene/*.js; do node --check $f || exit 1; done && echo OK",
    "ship": "bash scripts/ship.sh"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "three": "^0.170.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pj4533/election_night"
  },
  "engines": {
    "node": ">=24"
  }
}
